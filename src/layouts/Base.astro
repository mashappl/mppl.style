---
import '../styles/global.css';
import { t, href, swapLang, type Lang } from '../i18n';
interface Props { lang: Lang; title?: string; description?: string; ground?: 'sky' | 'grid' }
const { lang, title, description, ground = 'sky' } = Astro.props;
const s = t[lang];
const fullTitle = title ? `${title} · mppl.style` : 'mppl.style';
const path = Astro.url.pathname;
const here = path.replace(/^\/uk/, '') || '/';
const links = [
  { to: '/', label: s.nav.home, on: here === '/' },
  { to: '/homework/', label: s.nav.homework, on: here.startsWith('/homework') },
  { to: '/about/', label: s.nav.about, on: here.startsWith('/about') },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? s.metaDesc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href={new URL(lang === 'en' ? path : swapLang(lang, path), Astro.site)} />
    <link rel="alternate" hreflang="uk" href={new URL(lang === 'uk' ? path : swapLang(lang, path), Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=PT+Mono&family=Playfair+Display:ital,wght@1,800..900&family=Roboto+Flex:opsz,wdth,wght@8..144,25..151,300..900&display=swap" rel="stylesheet" />
  </head>
  <body class={`ground-${ground}`}>
    <svg class="defs" aria-hidden="true" width="0" height="0">
      <filter id="rough"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="3" /><feDisplacementMap in="SourceGraphic" scale="3" /></filter>
    </svg>
    <a class="skip" href="#main">skip to content</a>
    <header class="topbar">
      <a class="wordmark" href={href(lang, '/')} aria-label="mppl.style home">mppl<span>.style</span></a>
      <nav class="pills" aria-label="main">
        {links.map((l) => <a href={href(lang, l.to)} aria-current={l.on ? 'page' : undefined}>{l.label}</a>)}
        <a class="pill-lang" href={swapLang(lang, path)} hreflang={lang === 'en' ? 'uk' : 'en'} lang={lang === 'en' ? 'uk' : 'en'} aria-label={s.nav.otherLabel}>{s.nav.other}</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <span>© {new Date().getFullYear()} mariya popel</span>
      <span>{s.footer}</span>
      <span>mppl.style</span>
    </footer>
  </body>
</html>
