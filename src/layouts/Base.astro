---
import '../styles/global.css';
import { t, href, swapLang, getHomework, type Lang } from '../i18n';
interface Props { lang: Lang; title?: string; description?: string; back?: boolean }
const { lang, title, description, back = false } = Astro.props;
const s = t[lang];
const fullTitle = title ? `${title} · mppl.style` : 'mppl.style';
const path = Astro.url.pathname;
const here = path.replace(/^\/uk/, '') || '/';
const count = (await getHomework()).length;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? s.metaDesc} />
    <meta name="theme-color" content="#f6f5f2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang="en" href={new URL(lang === 'en' ? path : swapLang(lang, path), Astro.site)} />
    <link rel="alternate" hreflang="uk" href={new URL(lang === 'uk' ? path : swapLang(lang, path), Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <header class="site-head">
      <a class="site-name" href={href(lang, '/')} aria-label="mppl.style home">mppl.style</a>
      <span class="site-desc">{s.descriptor}</span>
      <nav class="site-nav" aria-label="main">
        {back
          ? <a href={href(lang, '/homework/')}>← {s.allHomeworks}</a>
          : <a href={href(lang, '/homework/')} aria-current={here === '/homework/' ? 'page' : undefined}>{s.count(count)}</a>}
        <a href={swapLang(lang, path)} hreflang={lang === 'en' ? 'uk' : 'en'} lang={lang === 'en' ? 'uk' : 'en'} aria-label={s.nav.otherLabel}>{s.nav.other}</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-foot">
      <span>{s.footer[0]}</span>
      <span>{s.footer[1]}</span>
      <span>2k{String(year).slice(2)}</span>
    </footer>
  </body>
</html>
