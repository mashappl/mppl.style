---
import HomeworkEntry from '../../../views/HomeworkEntry.astro';
import Study from '../../../views/Study.astro';
import Questionnaire from '../../../views/Questionnaire.astro';
import { getHomework } from '../../../i18n';
export async function getStaticPaths() {
  const all = await getHomework();
  const oldestFirst = [...all].reverse();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, n: oldestFirst.indexOf(entry) + 1 } }));
}
const { entry, n } = Astro.props;
const d = entry.data;
const isStudy = Boolean(d.meta || d.start || d.notice || d.outfits || d.reflection);
---
{d.form ? <Questionnaire lang="uk" entry={entry} n={n} /> : isStudy ? <Study lang="uk" entry={entry} n={n} /> : <HomeworkEntry lang="uk" entry={entry} />}
