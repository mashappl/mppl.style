---
// Outfit breakdown on a sheet of paper: the full look on a colour puddle + numbered pieces with handwritten notes.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Notebook from './Notebook.astro';
type LookData = NonNullable<CollectionEntry<'homework'>['data']['looks']>[number];
interface Props { look: LookData; n: number; label: string }
const { look, n, label } = Astro.props;
const num = (k: number) => `(${String(k + 1).padStart(2, '0')})`;
---
<Notebook binding="rings" class="look">
  <div class="look-head caps"><span>{label} {String(n + 1).padStart(2, '0')}</span>{look.title && <span class="hand look-title">{look.title}</span>}</div>
  <div class="look-grid" style={`--puddle:${look.colour}`}>
    <div class="look-hero">
      <span class="puddle" aria-hidden="true"></span>
      <Image src={look.photo} alt={look.title ?? 'outfit'} width={900} />
    </div>
    <ol class="look-pieces">
      {look.pieces.map((p, k) => (
        <li>
          <p><span class="look-num">{num(k)}</span><span class="hand">{p.note}</span></p>
          {p.image && <Image src={p.image} alt="" width={420} />}
        </li>
      ))}
    </ol>
  </div>
</Notebook>
