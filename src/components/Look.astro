---
// Outfit breakdown sheet: the full look on a colour puddle, pieces as framed details with notes.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Spec from './Spec.astro';
type LookData = NonNullable<CollectionEntry<'homework'>['data']['looks']>[number];
interface Props { look: LookData; n: number; label: string; detail: string }
const { look, n, label, detail } = Astro.props;
const total = look.pieces.length;
---
<section class="look sheet">
  <header class="sheet-head mono"><span>{label} {String(n + 1).padStart(2, '0')}</span>{look.title && <span>{look.title}</span>}</header>
  <div class="look-grid" style={`--puddle:${look.colour}`}>
    <div class="look-hero">
      <span class="puddle" aria-hidden="true"></span>
      <Image src={look.photo} alt={look.title ?? 'outfit'} width={900} />
    </div>
    <ol class="look-pieces">
      {look.pieces.map((p, k) => (
        <li>
          {p.image && <div class="detail-frame"><Image src={p.image} alt="" width={420} /></div>}
          <p class="mono">{detail} {k + 1}/{total}</p>
          <p class="hand">{p.note}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
