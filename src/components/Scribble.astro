---
// Handwritten note with a hand-drawn arrow.
interface Props { text: string; arrow?: 'down-right' | 'down-left' | 'up-right' | 'left' | 'none'; class?: string; style?: string }
const { text, arrow = 'down-right', class: cls = '', style } = Astro.props;
const paths: Record<string, string> = {
  'down-right': 'M6 6 C30 4 52 18 56 44 M46 36 L56 46 L62 33',
  'down-left': 'M58 6 C34 4 12 18 8 44 M2 33 L8 46 L18 36',
  'up-right': 'M6 46 C26 46 48 34 56 8 M46 12 L57 6 L60 19',
  left: 'M62 22 C44 30 24 30 6 20 M14 12 L5 20 L15 27',
};
---
<p class={`scribble-note hand ${cls}`} style={style}>
  <span>{text}</span>
  {arrow !== 'none' && <svg class={`arrow arrow-${arrow}`} viewBox="0 0 66 52" aria-hidden="true"><path d={paths[arrow]} /></svg>}
</p>
