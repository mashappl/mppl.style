---
// A notebook page: spiral binding across the top, or ring-binder rings down the left.
interface Props { binding?: 'spiral' | 'rings'; class?: string; style?: string }
const { binding = 'spiral', class: cls = '', style } = Astro.props;
const coils = Array.from({ length: binding === 'spiral' ? 18 : 6 });
---
<div class={`notebook nb-${binding} ${cls}`} style={style}>
  <div class="nb-binding" aria-hidden="true">
    {coils.map(() => binding === 'spiral' ? (
      <svg viewBox="0 0 24 46"><circle cx="12" cy="36" r="5" fill="#1a1a1a" /><path d="M8 37 C6 22 8 6 12 4 C16 6 18 22 16 37" fill="none" stroke="#b9bcc0" stroke-width="3.2" stroke-linecap="round" /><path d="M9 33 C8 20 9.5 8 12 6" fill="none" stroke="#fff" stroke-width="1" opacity=".7" /></svg>
    ) : (
      <svg viewBox="0 0 80 36"><circle cx="62" cy="18" r="6" fill="#2a2522" opacity=".55" /><path d="M2 18 C2 6 64 4 66 16" fill="none" stroke="#c0c3c7" stroke-width="5" stroke-linecap="round" /><path d="M4 15 C10 8 50 6 62 12" fill="none" stroke="#fff" stroke-width="1.4" opacity=".75" /></svg>
    ))}
  </div>
  <div class="nb-page"><slot /></div>
</div>
