---
// Home page collage: three photo sheets pinned together with safety pins (from the Figma mockup).
// Two compositions alternate down the page: 'a' (title under the middle sheet) and 'b' (title under the last).
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { t, href, type Lang } from '../i18n';
interface Props { entry: CollectionEntry<'homework'>; lang: Lang; n: number; variant: 'a' | 'b' }
const { entry, lang, n, variant } = Astro.props;
const s = t[lang];
const sheets = entry.data.sheets ?? (entry.data.cover ? [{ image: entry.data.cover, fit: 'contain' as const }] : []);
const pins = variant === 'a' ? ['/pins/pin-1.svg', '/pins/pin-2.svg'] : ['/pins/pin-3.svg', '/pins/pin-4.svg'];
const link = href(lang, `/homework/${entry.id}/`);
---
<article class={`collage collage-${variant}`}>
  <p class="label">{s.homeworkN} {String(n).padStart(2, '0')}<br />{entry.data.module}</p>
  <a class="sheets" href={link} aria-label={entry.data.title}>
    {sheets.map((sh, i) => (
      <span class={`sheet sheet-${i + 1}`}>
        <Image src={sh.image} alt="" width={720} class={sh.fit === 'cover' ? 'fit-cover' : 'fit-contain'} />
      </span>
    ))}
    {sheets.length > 1 && pins.slice(0, sheets.length - 1).map((p, i) => <img class={`spin spin-${i + 1}`} src={p} alt="" width="110" height="28" />)}
  </a>
  <div class="label study">
    <p class="study-title">{entry.data.title}</p>
    <a href={link}>{s.viewStudy} <span aria-hidden="true">↗</span></a>
  </div>
</article>
