---
// A printed page of the client questionnaire, drawn in HTML (used where a homework has no photos).
import type { Lang } from '../i18n';
import { questionnaire, formText } from '../data/questionnaire';
interface Props { lang: Lang; page: number }
const { lang, page } = Astro.props;
const secs = questionnaire.slice(page * 2, page * 2 + 2);
---
<div class="fsheet" aria-hidden="true">
  <p class="fsheet-head"><span>{formText[lang].sheetTitle}</span><span>{page + 1}/3</span></p>
  {secs.map((sec, i) => (
    <div class="fsheet-sec">
      <p class="fsheet-title">{String(page * 2 + i + 1).padStart(2, '0')} / {sec.title[lang]}</p>
      {sec.fields.slice(0, 4).map((fl) => (
        <div class="fsheet-row">
          <span class="fsheet-q">{fl.label[lang]}</span>
          {fl.type === 'choice' || fl.type === 'multi'
            ? <span class="fsheet-boxes">{fl.options.slice(0, 4).map((o) => <span><i></i>{o[lang]}</span>)}</span>
            : <span class="fsheet-line"></span>}
        </div>
      ))}
    </div>
  ))}
</div>
