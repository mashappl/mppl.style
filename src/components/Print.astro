---
// A loose photo print. Optional safety pin.
interface Props { pin?: 'top' | 'side' | 'none'; class?: string; style?: string }
const { pin = 'none', class: cls = '', style } = Astro.props;
---
<figure class={`print ${cls}`} style={style}>
  <div class="print-img"><slot /></div>
  {pin !== 'none' && (
    <svg class={`pin pin-${pin}`} viewBox="0 0 30 150" aria-hidden="true">
      <defs><linearGradient id="pinmetal" x1="0" x2="1"><stop offset="0" stop-color="#7c7e81" /><stop offset=".45" stop-color="#eceef0" /><stop offset="1" stop-color="#85878a" /></linearGradient></defs>
      <path d="M15 146 V26" stroke="url(#pinmetal)" stroke-width="2.4" stroke-linecap="round" />
      <path d="M8 138 V30 C8 18 22 18 22 30 V44" fill="none" stroke="url(#pinmetal)" stroke-width="2.4" stroke-linecap="round" />
      <circle cx="15" cy="148" r="4" fill="none" stroke="url(#pinmetal)" stroke-width="2" />
      <rect x="5" y="24" width="20" height="26" rx="5" fill="url(#pinmetal)" />
      <path d="M8 30 H22" stroke="#ffffff" stroke-width="1" opacity=".7" />
    </svg>
  )}
</figure>
