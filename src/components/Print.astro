---
// A physical photo print. Holder: binder clip, plastic sleeve, or a loose stack of prints.
interface Props { holder?: 'clip' | 'sleeve' | 'stack'; caption?: string; class?: string; style?: string }
const { holder = 'stack', caption, class: cls = '', style } = Astro.props;
---
<figure class={`print print-${holder} ${cls}`} style={style}>
  {holder === 'stack' && <><span class="sheet sheet-a" aria-hidden="true"></span><span class="sheet sheet-b" aria-hidden="true"></span></>}
  {holder === 'clip' && (
    <svg class="clip" viewBox="0 0 80 96" aria-hidden="true">
      <path d="M22 40 C18 8 30 4 40 4 C50 4 62 8 58 40" fill="none" stroke="#c9c9c4" stroke-width="4" stroke-linecap="round" />
      <path d="M26 40 C24 16 32 12 40 12 C48 12 56 16 54 40" fill="none" stroke="#8d8d88" stroke-width="2" />
      <path d="M6 44 L74 44 L68 92 L12 92 Z" fill="#151515" />
      <path d="M6 44 L74 44 L72 52 L8 52 Z" fill="#3a3a38" />
      <path d="M14 86 L66 86" stroke="#2c2c2a" stroke-width="3" />
    </svg>
  )}
  <div class="print-paper">
    <div class="print-img"><slot /></div>
    {caption && <figcaption class="print-cap">{caption}</figcaption>}
  </div>
  {holder === 'sleeve' && <span class="sleeve" aria-hidden="true"></span>}
</figure>
