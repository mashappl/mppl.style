---
import type { CollectionEntry } from 'astro:content';
import Print from './Print.astro';
import Thumb from './Thumb.astro';
import { href, formatDate, t, type Lang } from '../i18n';
interface Props { entry: CollectionEntry<'homework'>; lang: Lang; i: number }
const { entry, lang, i } = Astro.props;
const s = t[lang].hw;
const { title, module, date, cover } = entry.data;
const tilt = [-2.2, 0.6, 2.4, -1.2, 1.6][i % 5];
const shift = [0, -18, 6, -10, 12][i % 5];
---
<a class="hw-file" href={href(lang, `/homework/${entry.id}/`)} style={`--tilt:${tilt}deg; --shift:${shift}px`}>
  <Print pin={i % 3 === 1 ? 'top' : 'none'}><Thumb cover={cover} empty={s.nopic} /></Print>
  <p class="tag hw-tag">
    <span>{title}</span>
    {module && <span class="tag-gap">{module}</span>}
    <span class="tag-gap">{formatDate(lang, date)}</span>
  </p>
</a>
