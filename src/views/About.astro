---
import Base from '../layouts/Base.astro';
import Print from '../components/Print.astro';
import Thumb from '../components/Thumb.astro';
import Notebook from '../components/Notebook.astro';
import Scribble from '../components/Scribble.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
---
<Base lang={lang} title={s.nav.about}>
  <section class="ground-red about">
    <div class="about-stage">
      <div class="about-photo">
        <Print holder="clip" hand={s.about.caption}><Thumb empty={s.about.photoEmpty} /></Print>
      </div>
      <Notebook binding="spiral" class="about-book">
        <h1 class="wide">{s.about.title}</h1>
        <Scribble text={s.about.note} arrow="none" class="about-hi" />
        {s.about.p.map((p) => <p>{p}</p>)}
      </Notebook>
    </div>
  </section>
</Base>
