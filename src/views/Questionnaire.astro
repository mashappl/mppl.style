---
// Homework 01: the client brief. Questions live in src/data/brief.js; the form logic is
// public/brief/app.js (wizard, autosave, photos, PDF/HTML/JSON downloads). This page only
// provides the markup the script expects, in the site's editorial style.
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t, href, type Lang } from '../i18n';
import { BRIEF } from '../data/brief.js';
interface Props { lang: Lang; entry: CollectionEntry<'homework'>; n: number }
const { lang, entry, n } = Astro.props;
const s = t[lang];
const d = entry.data;
const nn = String(n).padStart(2, '0');
const words = d.title.toUpperCase().split(' ');
const mid = Math.ceil(words.length / 2);
const ukNote = lang === 'en' ? 'The brief itself is in Ukrainian, written for my Ukrainian-speaking clients.' : '';
---
<Base lang={lang} title={d.title} description={d.summary} back>
  <article class="study-page">
    <header class="st-intro st-grid">
      <a class="st-small" href={href(lang, '/homework/')}>←&nbsp;&nbsp;{s.allHomeworks}</a>
      <p class="st-small">{s.homeworkN} {nn}{d.module && ` / ${d.module}`}</p>
      <h1 class="st-title">{words.slice(0, mid).join(' ')}<br />{words.slice(mid).join(' ')}.</h1>
      <div>
        {d.summary && <p class="st-lede">{d.summary}</p>}
        {ukNote && <p class="st-lede brief-lang">{ukNote}</p>}
        {d.meta && <dl class="st-meta">{d.meta.map((m) => <div><dt>{m.k}</dt><dd>{m.v}</dd></div>)}</dl>}
      </div>
    </header>

    <div class="brief" lang="uk">
      <div class="brief-bar st-pad">
        <span class="st-small">анкета-бриф</span>
        <div class="topbar__meta">
          <span class="savestate st-tiny-reg" id="savestate" aria-live="polite"></span>
          <span class="counter st-small" id="counter" aria-hidden="true"></span>
        </div>
        <div class="progress" id="progress" role="progressbar" aria-label="Прогрес заповнення" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
      </div>

      <section class="screen welcome st-grid" id="welcome" aria-labelledby="welcome-title">
        <figure class="welcome__art" aria-hidden="true">
          <span class="wa-card wa-shoes"><img src="/brief/intro/shoes.jpg" alt="" width="1000" height="1500" loading="lazy" /></span>
          <span class="wa-card wa-cow"><img src="/brief/intro/cowhide.jpg" alt="" width="900" height="1150" loading="lazy" /></span>
          <span class="wa-card wa-dress"><img src="/brief/intro/dress.jpg" alt="" width="800" height="1000" loading="lazy" /></span>
        </figure>
        <div class="welcome__text">
          <h2 id="welcome-title" class="st-headline-lg"><span>Розкажи про себе,</span><span>а я — про твій стиль</span></h2>
          <p class="st-lede">Ця анкета — перший крок нашої роботи. Вона допоможе мені побачити, як ти живеш, що відчуваєш і чого насправді хочеш від гардеробу. Тоді рекомендації будуть про тебе, а не про картинку з Pinterest.</p>
          <ul class="facts">
            <li><strong>15–20 хв</strong><span>11 коротких розділів</span></li>
            <li><strong>Чесно</strong><span>немає правильних відповідей</span></li>
            <li><strong>Приватно</strong><span>бачу лише я</span></li>
          </ul>
          <div class="prep">
            <p class="st-small">Що знадобиться</p>
            <ul>
              <li>Сантиметрова стрічка для параметрів</li>
              <li>3 фото при денному світлі: анфас, профіль, обличчя</li>
              <li>За бажанням — дошка Pinterest з образами, що подобаються</li>
            </ul>
          </div>
          <div class="welcome__actions">
            <button class="btn btn--primary" id="start" type="button">Почати</button>
            <button class="btn btn--ghost" id="restart" type="button" hidden>Почати заново</button>
          </div>
          <p class="note">Відповіді автоматично зберігаються в цьому браузері — можна зупинитись і повернутись пізніше.</p>
        </div>
      </section>

      <section class="screen formwrap st-grid" id="formwrap" hidden>
        <nav class="steps" aria-label="Розділи анкети"><ol id="stepnav"></ol></nav>
        <form id="brief" novalidate>
          <div id="step" class="step" aria-live="off"></div>
          <div class="formnav">
            <button class="btn btn--ghost" type="button" id="prev">← Назад</button>
            <span class="formnav__hint st-tiny-reg" id="navhint"></span>
            <button class="btn btn--primary" type="submit" id="next">Далі →</button>
          </div>
        </form>
      </section>

      <section class="screen thanks st-grid" id="thanks" hidden aria-labelledby="thanks-title" tabindex="-1">
        <div>
          <p class="st-small">Бриф отримано</p>
          <h2 id="thanks-title" class="st-headline-lg">Дякую, <em id="thanks-name">що довірилась</em></h2>
        </div>
        <div>
          <p class="st-lede" id="thanks-lead">Я уважно прочитаю твої відповіді й напишу протягом 2 робочих днів, щоб домовитись про першу зустріч.</p>
          <div class="callout" id="thanks-callout" hidden></div>
          <div class="downloads">
            <p class="st-small">Збережи копію своїх відповідей</p>
            <div class="downloads__row">
              <button class="btn btn--primary" type="button" id="dl-pdf">Зберегти як PDF</button>
              <button class="btn btn--ghost" type="button" id="dl-html">Завантажити HTML</button>
              <button class="btn btn--ghost" type="button" id="dl-json">Завантажити JSON</button>
            </div>
            <p class="note">PDF відкриє вікно друку — обери «Зберегти як PDF». HTML-файл містить і фото.</p>
          </div>
          <div class="thanks__actions">
            <button class="btn btn--link" type="button" id="edit">Повернутись і змінити відповіді</button>
            <button class="btn btn--link" type="button" id="reset">Очистити анкету на цьому пристрої</button>
          </div>
        </div>
      </section>
      <span id="year" hidden></span>
    </div>

    <footer class="st-end st-pad">
      <a class="st-small" href={href(lang, '/homework/')}>←&nbsp;&nbsp;{s.backAll}</a>
      <p class="st-tiny-reg">mppl.style / {s.notebook} / {nn}</p>
    </footer>
  </article>
  <script is:inline define:vars={{ BRIEF }}>window.BRIEF = BRIEF;</script>
  <script is:inline src="/brief/app.js"></script>
</Base>
