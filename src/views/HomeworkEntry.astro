---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Print from '../components/Print.astro';
import Thumb from '../components/Thumb.astro';
import Spec from '../components/Spec.astro';
import Look from '../components/Look.astro';
import { t, href, formatDate, type Lang } from '../i18n';
interface Props { lang: Lang; entry: CollectionEntry<'homework'> }
const { lang, entry } = Astro.props;
const s = t[lang];
const { Content } = await render(entry);
const { title, module, date, summary, cover, looks } = entry.data;
const rows = [...(module ? [{ k: s.hw.spec.module, v: module }] : []), { k: s.hw.spec.date, v: formatDate(lang, date) }];
---
<Base lang={lang} title={title} description={summary}>
  <section class="page-top">
    <article class="entry wrap">
      <a class="link-cta mono back" href={href(lang, '/homework/')}>← {s.hw.back}</a>
      <h1 class="mono display-s entry-title">{title}</h1>
      {summary && <p class="hand entry-sum">{summary}</p>}
      <Spec rows={rows} />
      {cover && <Print pin="top" class="entry-cover"><Thumb cover={cover} empty="" ratio="auto" /></Print>}
      <div class="prose"><Content /></div>
      {looks?.map((look, n) => <Look look={look} n={n} label={s.look.title} detail={s.detail} />)}
    </article>
  </section>
</Base>
