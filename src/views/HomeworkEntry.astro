---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Print from '../components/Print.astro';
import Thumb from '../components/Thumb.astro';
import Notebook from '../components/Notebook.astro';
import Spec from '../components/Spec.astro';
import Look from '../components/Look.astro';
import { t, href, formatDate, type Lang } from '../i18n';
interface Props { lang: Lang; entry: CollectionEntry<'homework'> }
const { lang, entry } = Astro.props;
const s = t[lang];
const { Content } = await render(entry);
const { title, module, date, summary, cover, looks } = entry.data;
const rows = [...(module ? [{ k: s.hw.spec.module, v: module }] : []), { k: s.hw.spec.date, v: formatDate(lang, date) }];
---
<Base lang={lang} title={title} description={summary}>
  <section class="ground-red page-top">
    <article class="entry">
      <a class="link-cta caps back" href={href(lang, '/homework/')}>← {s.hw.back}</a>
      <Notebook binding="rings" class="entry-book">
        <h1 class="wide entry-title">{title}</h1>
        {summary && <p class="hand entry-sum">{summary}</p>}
        <Spec rows={rows} />
        {cover && <Print holder="clip" class="entry-cover" caption={entry.id + '.jpg'}><Thumb cover={cover} empty="" ratio="auto" /></Print>}
        <div class="prose"><Content /></div>
      </Notebook>
      {looks?.map((look, n) => <Look look={look} n={n} label={s.look.title} />)}
    </article>
  </section>
</Base>
