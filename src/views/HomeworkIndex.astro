---
import Base from '../layouts/Base.astro';
import Scribble from '../components/Scribble.astro';
import HomeworkFile from '../components/HomeworkFile.astro';
import { t, getHomework, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const entries = await getHomework();
---
<Base lang={lang} title={s.nav.homework}>
  <section class="page-top">
    <header class="strip-head wrap">
      <h1 class="mono display-s">{s.hw.title}</h1>
      <Scribble text={s.hw.notes[2]} arrow="loop-down" class="strip-note1" />
    </header>
    <p class="mono para wrap index-para">{s.hw.sub}</p>
    {entries.length
      ? <div class="strip strip-wrap">{entries.map((e, i) => <HomeworkFile entry={e} lang={lang} i={i} />)}</div>
      : <p class="empty hand wrap">{s.hw.empty}</p>}
  </section>
</Base>
