---
// Homework list: editorial index in the same system as the case studies.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FormSheet from '../components/FormSheet.astro';
import { t, href, formatDate, getHomework, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const ordered = [...(await getHomework())].reverse(); // homework 01 first
const tilts = [[-3, 1.5, 4], [2, -2, -4], [-1.5, 3, -3]];
---
<Base lang={lang} title={s.nav.homework}>
  <div class="study-page">
    <header class="st-intro st-grid">
      <p class="st-small">{s.descriptor}</p>
      <p class="st-small">{s.count(ordered.length)}</p>
      <h1 class="st-title">{s.index.title[0]}<br />{s.index.title[1]}</h1>
      <p class="st-lede">{s.index.lede}</p>
    </header>

    {ordered.length === 0 && <p class="st-pad st-small">{s.hw.empty}</p>}
    <ol class="hw-index">
      {ordered.map((e, i) => {
        const link = href(lang, `/homework/${e.id}/`);
        const pics = e.data.sheets ?? (e.data.cover ? [{ image: e.data.cover, fit: 'contain' as const }] : []);
        const tl = tilts[i % tilts.length];
        return (
          <li class="hw-row st-grid">
            <div class="hw-row-text">
              <p class="st-small">{s.homeworkN} {String(i + 1).padStart(2, '0')}{e.data.module && ` / ${e.data.module}`}</p>
              <h2 class="st-title"><a href={link}>{e.data.title}.</a></h2>
              {e.data.summary && <p class="st-lede">{e.data.summary}</p>}
              <p class="st-small hw-row-meta">{formatDate(lang, e.data.date)}</p>
              <a class="st-small" href={link}>{s.viewStudy} ↗</a>
            </div>
            <a class="hw-stack" href={link} aria-label={e.data.title}>
              {pics.length === 0 && e.data.form && [0, 1, 2].map((pg) => <span class={`hw-stack-sheet hw-stack-${pg + 1}`} style={`rotate:${tl[pg]}deg`}><FormSheet page={pg} /></span>)}
              {pics.map((p, j) => (
                <span class={`hw-stack-sheet hw-stack-${j + 1}`} style={`rotate:${tl[j]}deg`}>
                  <Image src={p.image} alt="" width={500} class={p.fit === 'cover' ? 'fit-cover' : 'fit-contain'} />
                </span>
              ))}
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</Base>
