---
import Base from '../layouts/Base.astro';
import Scribble from '../components/Scribble.astro';
import HomeworkFile from '../components/HomeworkFile.astro';
import { t, getHomework, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const entries = await getHomework();
---
<Base lang={lang} title={s.nav.homework}>
  <section class="ground-crumple page-top">
    <div class="wrap">
      <div class="sec-head">
        <h1 class="wide">{s.hw.title}</h1>
        <p class="caps">{s.hw.sub}</p>
        <Scribble text={s.hw.note} arrow="down-right" class="sec-note" />
      </div>
      {entries.length
        ? <div class="hw-grid">{entries.map((e, i) => <HomeworkFile entry={e} lang={lang} i={i} />)}</div>
        : <p class="empty hand">{s.hw.empty}</p>}
    </div>
  </section>
</Base>
