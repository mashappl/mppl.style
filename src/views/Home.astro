---
import Base from '../layouts/Base.astro';
import Collage from '../components/Collage.astro';
import { getHomework, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const entries = await getHomework();
// Numbered and listed oldest-first: homework 01, 02…
const ordered = [...entries].reverse();
---
<Base lang={lang}>
  <div class="collages">
    {ordered.map((e, i) => <Collage entry={e} lang={lang} n={i + 1} variant={i % 2 === 0 ? 'a' : 'b'} />)}
  </div>
</Base>
