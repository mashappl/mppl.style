---
import Base from '../layouts/Base.astro';
import Print from '../components/Print.astro';
import Notebook from '../components/Notebook.astro';
import Scribble from '../components/Scribble.astro';
import Thumb from '../components/Thumb.astro';
import HomeworkFile from '../components/HomeworkFile.astro';
import { t, href, getHomework, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const entries = await getHomework();
const latest = entries.slice(0, 4);
const fitCover = entries.find((e) => e.data.cover)?.data.cover;
const swatches = ['#7a4a2b', '#b36a3c', '#c99a5b', '#8a8b4c', '#4f5e3a', '#9c4a3e', '#d9b48f', '#5b3a2e'];
const year = new Date().getFullYear();
---
<Base lang={lang}>
  <section class="ground-red hero">
    <div class="hero-stage">
      <div class="hero-stack">
        <Print holder="stack" class="hero-print">
          <Thumb cover={fitCover} empty={s.fit.empty} ratio="3 / 2" />
        </Print>
        <Scribble text={s.hero.note} arrow="down-left" class="hero-note" />
      </div>

      <div class="hero-title">
        <h1 class="wide">{s.hero.title}</h1>
        <p class="caps">{s.hero.meta}</p>
        <p class="caps">{year}</p>
        <a class="link-cta caps" href={href(lang, '/homework/')}>{s.hero.cta} →</a>
      </div>

      <Print holder="paperclip" class="hero-palette" caption={s.palette.note}>
        <div class="palette">{swatches.map((c) => <span style={`background:${c}`}></span>)}</div>
        <p class="hand palette-name">{s.palette.name}</p>
      </Print>

      <Notebook binding="spiral" class="hero-capsule">
        <p class="caps nb-title">{s.capsule.title}</p>
        <ul class="ticks">{s.capsule.items.map((it) => <li class="hand">{it}</li>)}</ul>
      </Notebook>

      <p class="corner corner-l caps"><span>{s.corner[0]}</span><span>{s.corner[1]}</span></p>
    </div>
  </section>

  <section class="ground-crumple hw-section">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="wide">{s.hw.title}</h2>
        <p class="caps">{s.hw.sub}</p>
        <Scribble text={s.hw.note} arrow="down-right" class="sec-note" />
      </div>
      {latest.length
        ? <div class="hw-grid">{latest.map((e, i) => <HomeworkFile entry={e} lang={lang} i={i} />)}</div>
        : <p class="empty hand">{s.hw.empty}</p>}
      <a class="link-cta caps dark" href={href(lang, '/homework/')}>{s.hw.all} →</a>
    </div>
  </section>

  <section class="ground-red plan">
    <div class="wrap">
      <Notebook binding="rings" class="plan-book">
        <div class="plan-head">
          <h2 class="wide">{s.plan.title}</h2>
          <Scribble text={s.plan.note} arrow="down-right" class="plan-note" />
        </div>
        <ol class="plan-list">
          {s.plan.cards.map((c, i) => (
            <li>
              <span class="caps plan-num">({String(i + 1).padStart(2, '0')})</span>
              <h3 class="caps">{c.title}</h3>
              <p>{c.body}</p>
            </li>
          ))}
        </ol>
      </Notebook>
    </div>
  </section>

  <section class="ground-red close">
    <p class="wide close-text">{s.close.l1}<span class="hand">{s.close.l2}</span></p>
  </section>
</Base>
